      "checks" : [
        {
          "detail" : "All 52 authored solids are mapped, including nine recovered enclosure and chip-guard bodies. Exported body bounds match the saved Fusion model within 0.000003 mm. Intentional simplifications remain documented.",
          "id" : "complete-geometry",
          "scope" : "geometry",
          "sourceIDs" : [
            "step-audit",
            "fusion-audit",
            "geometry-tests"
          ],
          "status" : "passed",
          "title" : "Complete machine model"
        },
        {
          "detail" : "X moves the table; Y carries Z and the spindle. Controller-to-model home conversion and nested motion are checked. Selected Z stop and upper-Y clearance tests corroborate the CAD ranges; physical calibration is a separate commissioning step.",
          "id" : "digital-motion",
          "scope" : "kinematics",
          "sourceIDs" : [
            "fusion-definition",
            "geometry-tests"
          ],
          "status" : "passed",
          "title" : "Axis motion and home pose"
        },
        {
          "detail" : "A dedicated seating frame removes the machining-axis\/seating-axis ambiguity. The asymmetric 203.2 × 37 × 50.8 mm block lies on the measured table plane and inside its support footprint; its dimensions remain in their intended directions.",
          "id" : "stock-seating",
          "scope" : "setupPlacement",
          "sourceIDs" : [
            "geometry-tests",
            "geometry-resolution"
          ],
          "status" : "passed",
          "title" : "Stock sits on the X table"
        },
        {
          "detail" : "The machine interface is the 6.13 mm opening above a 12 × 3 mm cavity. The Bookend's custom M5 nut and 6 × 1.8 mm key fit the actual CAD slots. Fastener selection belongs to the fixture, so the table is not restricted to a generic M4 label.",
          "id" : "slot-mounting",
          "scope" : "setupPlacement",
          "sourceIDs" : [
            "geometry-tests",
            "geometry-resolution"
          ],
          "status" : "passed",
          "title" : "Bookend mounting fits both T-slots"
        },
        {
          "detail" : "Use an 8 mm maximum shank and the supplied conservative 75 mm overall-length planning cap. Nominal collet seating is 22.9 mm. Cutting diameter and measured exposed stickout are separate tool-assembly inputs; the source's 7 mm diameter value is retained without calling it a proved hardware limit.",
          "id" : "tool-dimensions",
          "scope" : "tooling",
          "sourceIDs" : [
            "controller-review",
            "fusion-definition"
          ],
          "status" : "passed",
          "title" : "Tool dimensions have distinct meanings"
        },
        {
          "detail" : "Generated programs use the manufacturer-supported 1500–8000 RPM range. Firmware report limits of 1360–8500 RPM are retained as controller metadata, without treating them as usable cutting speeds.",
          "id" : "usable-spindle",
          "scope" : "tooling",
          "sourceIDs" : [
            "controller-review",
            "fusion-definition"
          ],
          "status" : "passed",
          "title" : "Usable spindle speed applied"
        },
        {
          "detail" : "The profile names its actual native post adapter. Feed and arc-centre modes, bounded ASCII comments, RPM limits and generated-job preflight pass regression tests. Existing tool-length compensation is preserved consistently with touch-off. No Fusion CPS or physical controller is claimed tested.",
          "id" : "native-post",
          "scope" : "controller",
          "sourceIDs" : [
            "controller-review"
          ],
          "status" : "passed",
          "title" : "Coastline GRBL adapter checked"
        },
        {
          "detail" : "One installed tool per program, with guided changes between programs. No M6 or tool preload is emitted. The imported preload flag and 15-second estimate are not automatic-tool-changer capabilities.",
          "id" : "manual-tooling",
          "scope" : "controller",
          "sourceIDs" : [
            "controller-review",
            "fusion-definition"
          ],
          "status" : "passed",
          "title" : "Manual tool changes selected"
